# Copy to .env and fill in real values. Never commit the real .env.

# Secret used to sign JWTs (use a long random string)
JWT_SECRET=change-me

# Server port (optional, defaults to 3000)
PORT=3000

# PostgreSQL connection (either set DATABASE_URL OR the discrete PG* vars)
# DATABASE_URL=postgres://user:password@localhost:5432/auth_practice
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=auth_practice
