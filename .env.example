# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gis_engine
DB_USER=postgres
DB_PASSWORD=your_password

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Google Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
NODE_APP_PORT=3000

# JWT Secret for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Cache Configuration
CACHE_TTL_SECONDS=172800  # 48 hours

# Logging
LOG_LEVEL=INFO

# KGIS API Configuration
KGIS_API_URL=https://kgis.ksrsac.in:9000/genericwebservices/ws/surveyno
KGIS_LULC_URL=https://kgis.ksrsac.in/kgismaps1/rest/services/NR_V2/LULC_10K/MapServer/0/query
KGIS_ADMIN_URL=https://kgis.ksrsac.in:9000/genericwebservices/ws/nearbyadminhierarchy

# Node.js Environment
NODE_ENV=development
REDIS_URL=redis://localhost:6379
