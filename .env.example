DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ribil

REDIS_URL=redis://redis:6379

JWT_PRIVATE_KEY=replace_me
JWT_PUBLIC_KEY=replace_me

SENDGRID_API_KEY=replace_me

AWS_ACCESS_KEY=replace_me
AWS_SECRET_KEY=replace_me
AWS_REGION=ap-south-1

GMAPS_KEY=replace_me

S3_BUCKET=alstonaire-docs

# Document storage driver: "s3" (default when AWS creds present) or "local" (dev).
STORAGE_DRIVER=local
# HMAC secret used to sign local-driver download URLs (dev only).
LOCAL_SIGN_SECRET=replace_me
# Beta document classifier base URL; if unset, an "other" stub is used.
CLASSIFIER_URL=
# Set to "true" to skip ClamAV (falls back to EICAR signature detection).
SKIP_VIRUS_SCAN=
